  "response_html": "<!DOCTYPE html>\n<html>\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Session Feedback</title>\n</head>\n<body style=\"margin: 0; padding: 0; background-color: #F9FAFB; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;\">\n\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color: #F9FAFB; padding: 48px 16px;\">\n    <tr>\n      <td align=\"center\">\n\n        <!-- Main Card -->\n        <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"max-width: 600px; background-color: #FFFFFF; border-radius: 12px; overflow: hidden; box-shadow: 0 4px 24px rgba(17, 24, 39, 0.06);\">\n\n          <!-- Top Accent Line -->\n          <tr>\n            <td style=\"height: 4px; background-color: #4F46E5;\"></td>\n          </tr>\n\n          <!-- Header -->\n          <tr>\n            <td style=\"padding: 32px 40px 0 40px;\">\n              <p style=\"margin: 0; font-size: 13px; font-weight: 600; color: #4F46E5; letter-spacing: 0.8px; text-transform: uppercase;\">\n                Tech4Good Community\n              </p>\n            </td>\n          </tr>\n\n          <!-- Body -->\n          <tr>\n            <td style=\"padding: 20px 40px 40px 40px;\">\n\n              <h1 style=\"margin: 0 0 24px 0; font-size: 22px; font-weight: 600; color: #111827; line-height: 1.35;\">\n                We’d love your feedback\n              </h1>\n\n              <p style=\"margin: 0 0 16px 0; font-size: 16px; line-height: 1.6; color: #111827;\">\n                Hello,\n              </p>\n\n              <p style=\"margin: 0 0 16px 0; font-size: 16px; line-height: 1.65; color: #374151;\">\n                Thank you for participating in the recent session:  \n                <strong style=\"color: #111827;\">{{ doc.topic }}</strong>.\n              </p>\n\n              <p style=\"margin: 0 0 32px 0; font-size: 16px; line-height: 1.65; color: #374151;\">\n                We hope you found the session valuable. Your feedback helps us improve the quality of future sessions.\n              </p>\n\n              <!-- CTA Button -->\n              <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"margin-bottom: 40px;\">\n                <tr>\n                  <td style=\"background-color: #4F46E5; border-radius: 8px;\">\n                    <a href=\"{{ frappe.utils.get_url() }}/session-feedback?new=1&mentoring_session={{ doc.name }}&respondent_email={{ fellow_email }}\"\n                       style=\"display: inline-block; padding: 14px 32px; font-size: 15px; font-weight: 600; color: #FFFFFF; text-decoration: none; border-radius: 8px;\">\n                      Submit Your Feedback\n                    </a>\n                  </td>\n                </tr>\n              </table>\n\n              <!-- Session Details -->\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color: #F9FAFB; border-radius: 10px; border: 1px solid #E5E7EB;\">\n                <tr>\n                  <td style=\"padding: 24px 28px;\">\n                    <p style=\"margin: 0 0 16px 0; font-size: 12px; font-weight: 600; color: #6B7280; text-transform: uppercase; letter-spacing: 0.5px;\">\n                      Session Details\n                    </p>\n\n                    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                      <tr>\n                        <td style=\"padding: 6px 0; font-size: 14px; color: #6B7280; width: 100px;\">Session ID</td>\n                        <td style=\"padding: 6px 0; font-size: 14px; color: #111827; font-weight: 500;\">{{ doc.name }}</td>\n                      </tr>\n                      <tr>\n                        <td style=\"padding: 6px 0; font-size: 14px; color: #6B7280; width: 100px;\">Topic</td>\n                        <td style=\"padding: 6px 0; font-size: 14px; color: #111827; font-weight: 500;\">{{ doc.topic }}</td>\n                      </tr>\n                      <tr>\n                        <td style=\"padding: 6px 0; font-size: 14px; color: #6B7280; width: 100px;\">Date</td>\n                        <td style=\"padding: 6px 0; font-size: 14px; color: #111827; font-weight: 500;\">{{ frappe.utils.formatdate(doc.session_date) }}</td>\n                      </tr>\n                      <tr>\n                        <td style=\"padding: 6px 0; font-size: 14px; color: #6B7280; width: 100px;\">Mentor</td>\n                        <td style=\"padding: 6px 0; font-size: 14px; color: #111827; font-weight: 500;\">{{ doc.mentor }}</td>\n                      </tr>\n                    </table>\n                  </td>\n                </tr>\n              </table>\n\n            </td>\n          </tr>\n\n          <!-- Footer -->\n          <tr>\n            <td style=\"padding: 20px 40px; background-color: #F9FAFB; border-top: 1px solid #E5E7EB; text-align: center;\">\n              <p style=\"margin: 0; font-size: 13px; color: #6B7280;\">\n                Tech4Good Community Lecture Series\n              </p>\n            </td>\n          </tr>\n\n        </table>\n\n      </td>\n    </tr>\n  </table>\n\n</body>\n</html>",
  "subject": "Session Feedback: {{ doc.topic }}",
  "use_html": 1

ntor_name }}</strong> has been \n                <strong style=\"color: #2D3748;\">{{ action_label | lower }}</strong>.\n              </p>\n\n              <!-- Session Details Card -->\n              <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" style=\"background-color: #FAF8F5; border-radius: 12px; border: 1px solid #EDE8E2; margin-bottom: 32px;\">\n                <tr>\n                  <td style=\"padding: 24px 28px;\">\n                    <p style=\"margin: 0 0 16px 0; font-size: 12px; font-weight: 600; color: #A0AEC0; text-transform: uppercase; letter-spacing: 0.5px;\">\n                      Session Details\n                    </p>\n\n                    <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n                      <tr>\n                        <td style=\"padding: 6px 0; font-size: 14px; color: #718096; width: 90px; vertical-align: top;\">Topic</td>\n                        <td style=\"padding: 6px 0; font-size: 14px; color: #2D3748; font-weight: 500;\">{{ doc.topic }}</td>\n                      </tr>\n                      <tr>\n                        <td style=\"padding: 6px 0; font-size: 14px; color: #718096; width: 90px; vertical-align: top;\">Mentor</td>\n                        <td style=\"padding: 6px 0; font-size: 14px; color: #2D3748; font-weight: 500;\">{{ mentor_name }}</td>\n                      </tr>\n                      <tr>\n                        <td style=\"padding: 6px 0; font-size: 14px; color: #718096; width: 90px; vertical-align: top;\">Date</td>\n                        <td style=\"padding: 6px 0; font-size: 14px; color: #2D3748; font-weight: 500;\">{{ doc.session_date }}</td>\n                      </tr>\n                      <tr>\n                        <td style=\"padding: 6px 0; font-size: 14px; color: #718096; width: 90px; vertical-align: top;\">Time</td>\n                        <td style=\"padding: 6px 0; font-size: 14px; color: #2D3748; font-weight: 500;\">{{ doc.start_time }} – {{ doc.end_time }}</td>\n                      </tr>\n                    </table>\n                  </td>\n                </tr>\n              </table>\n\n              <!-- CTA Button -->\n              <table cellpadding=\"0\" cellspacing=\"0\" border=\"0\" width=\"100%\">\n                <tr>\n                  <td align=\"center\">\n                    <a href=\"{{ doc.meet_link }}\"\n                       style=\"display: inline-block; background-color: #E05638; color: #FFFFFF; text-decoration: none; padding: 14px 36px; font-size: 15px; font-weight: 600; border-radius: 10px;\">\n                      Join Google Meet\n                    </a>\n                  </td>\n                </tr>\n              </table>\n\n              <p style=\"margin: 22px 0 0 0; font-size: 13px; line-height: 1.5; color: #718096; text-align: center;\">\n                Or copy this link:<br>\n                <a href=\"{{ doc.meet_link }}\" style=\"color: #E05638; text-decoration: none; word-break: break-all;\">{{ doc.meet_link }}</a>\n              </p>\n\n            </td>\n          </tr>\n\n          <!-- Footer -->\n          <tr>\n            <td style=\"padding: 20px 40px; background-color: #FAF8F5; border-top: 1px solid #EDE8E2; text-align: center;\">\n              <p style=\"margin: 0; font-size: 13px; color: #718096;\">\n                Tech4Good Community Lecture Series\n              </p>\n            </td>\n          </tr>\n\n        </table>\n\n      </td>\n    </tr>\n  </table>\n\n</body>\n</html>",
